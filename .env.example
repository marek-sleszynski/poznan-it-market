LOG_LEVEL=INFO
JJIT_API_URL=https://justjoin.it/api/candidate-api/offers

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=poznan_it_market
POSTGRES_PORT=5432

# Local database URLs use the same port as Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/poznan_it_market
DEMO_DATABASE_URL=postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/poznan_it_market_demo
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/poznan_it_market_test

# Cloud runs use a complete DATABASE_URL from GitHub secrets.
